# Pick ONE brain. With no key set, Flash Crash runs offline in mock mode.
# Nebius Token Factory (NVIDIA Nemotron)
NEBIUS_API_KEY=
# Amazon Bedrock (OpenAI-compatible endpoint, Bedrock API key)
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-west-2
# Force a provider: nebius | bedrock | openai | mock
FLASHCRASH_PROVIDER=
# Optional overrides
FAST_MODEL=
BIG_MODEL=
LLM_BASE_URL=
# Real headlines (optional)
TAVILY_API_KEY=
# Tuning
AGENTS=300
CONCURRENCY=24
# AI newsroom headlines are enabled by default, at a random interval in this range (seconds).
AUTOPILOT_NEWS_MIN_SECONDS=45
AUTOPILOT_NEWS_MAX_SECONDS=75
PORT=8000
# Public URL shown in the TV QR code (e.g. a tunnel); defaults to LAN IP
PUBLIC_URL=
# Market Days (optional, persistent Railway/PostgreSQL mode; never expose Alpaca credentials to Vercel)
DATABASE_URL=
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
MARKET_DAYS_ALLOWED_ORIGINS=
MARKET_DAYS_ADMIN_TOKEN=
MARKET_DAYS_AUTOPILOT_MINUTES=0
MARKET_DAYS_MAX_ORDER_QTY=25
