# Pick ONE brain. With no key set, Flash Crash runs offline in mock mode.
# Nebius Token Factory (NVIDIA Nemotron)
NEBIUS_API_KEY=
# Amazon Bedrock (OpenAI-compatible endpoint, Bedrock API key)
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-west-2
# Force a provider: nebius | bedrock | openai | mock
FLASHCRASH_PROVIDER=
# Optional overrides
FAST_MODEL=
BIG_MODEL=
LLM_BASE_URL=
# Real headlines (optional)
TAVILY_API_KEY=
# Tuning
AGENTS=300
CONCURRENCY=24
PORT=8000
# Public URL shown in the TV QR code (e.g. a tunnel); defaults to LAN IP
PUBLIC_URL=
